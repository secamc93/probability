# Credenciales para uso por IA (Claude Code u otros) en testing E2E.
# Copiar a .env.ai (gitignored) y rellenar con credenciales de tu entorno de prueba.

# Super admin (business_id = 0 en JWT)
AI_SUPER_ADMIN_EMAIL=
AI_SUPER_ADMIN_PASSWORD=

# Usuario business demo (no super admin)
AI_DEMO_EMAIL=
AI_DEMO_PASSWORD=

# Cuenta que se entrega a los revisores externos (Google Play, Shopify, Meta).
# Negocio propio con datos de prueba, rol Administrador, suscripcion sin vencer.
AI_REVIEW_EMAIL=
AI_REVIEW_PASSWORD=
